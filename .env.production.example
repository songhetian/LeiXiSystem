# ============================================================================
# 雷犀管理系统 · 生产环境配置模板
# 拷贝本文件为 .env.production，填入实际值后使用。
# docker-compose 部署时执行：docker compose --env-file .env.production up -d
# ============================================================================

# ===== 运行环境 =====
NODE_ENV=production

# ===== 后端启动行为 =====
# 容器启动时是否执行种子数据。生产环境必须保持 false：
# 迁移（prisma migrate deploy）始终执行；种子会写入演示数据，禁止在生产库执行。
SEED_ON_BOOT=false
# 种子脚本写入范围（仅 SEED_ON_BOOT=true 时有意义）。
# 生产首次初始化：SEED_ON_BOOT=true + SEED_DEMO=false —— 只灌权限点/角色/admin 账号/
# 默认部门/13 条默认审批流程等基础数据，不写演示员工、工资条、公告与 staff 演示账号。
# 灌完后把 SEED_ON_BOOT 改回 false，避免每次重启重复执行。
SEED_DEMO=false

# ===== 前端服务 =====
FRONTEND_PORT=4000
NEXT_PUBLIC_APP_PORT=4000
# Docker 内部，前端通过 nginx 反代到 backend
API_PROXY_TARGET=http://backend:4001

# ===== 后端服务 =====
BACKEND_PORT=4001
PORT=4001
JWT_SECRET=<生成一个 64 位随机字符串，勿用默认值>
JWT_EXPIRES_IN=7d
PREVIEW_SECRET=<生成一个 16 位以上随机字符串，勿用默认值>
# 生产环境域名，如 https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ===== MySQL / 阿里云 RDS =====
# 使用阿里云 RDS 时，填写 RDS 连接地址
DATABASE_URL=mysql://user:password@your-rds-host.xxx.rds.aliyuncs.com:3306/leixin_v2
MYSQL_ROOT_PASSWORD=<生产环境 RDS 密码>
MYSQL_DATABASE=leixin_v2

# ===== Redis =====
# 使用阿里云 Redis 时，填写 Redis 连接地址
REDIS_URL=redis://:password@your-redis-host.redis.rds.aliyuncs.com:6379
REDIS_PASSWORD=<生产环境 Redis 密码>

# ===== 阿里云 OSS（对象存储）=====
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=<OSS Bucket 名称>
OSS_ACCESS_KEY=<阿里云 RAM 子账号 AccessKey>
OSS_ACCESS_SECRET=<阿里云 RAM 子账号 AccessSecret>
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 文件存储驱动：local=本地磁盘 uploads/（开发默认）；oss=阿里云 OSS（生产必须设为 oss 并配置上方 OSS_*）
FILE_STORAGE=oss

# ===== SMTP 邮件（通知服务，待接入）=====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password