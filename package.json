{
  "name": "leixi-system",
  "version": "1.0.0",
  "private": true,
  "description": "雷犀内部管理系统 - 全新重构 monorepo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "onlyBuiltDependencies": [
    "esbuild",
    "prisma",
    "@prisma/engines",
    "@prisma/client"
  ],
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:server": "pnpm --filter @leixi/server dev",
    "dev:web": "pnpm --filter @leixi/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @leixi/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @leixi/shared test:watch",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @leixi/server db:generate",
    "db:migrate": "pnpm --filter @leixi/server db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}