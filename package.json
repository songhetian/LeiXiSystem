    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@mantine/core": "^7.6.0",
    "@mantine/dates": "^8.3.18",
    "@mantine/form": "^7.6.0",
    "@mantine/hooks": "^7.6.0",
    "@mantine/modals": "^8.3.18",
    "@mantine/notifications": "^7.6.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.25.0",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.1",
    "clsx": "^2.1.0",
