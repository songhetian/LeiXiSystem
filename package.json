{
  "name": "leixi-system-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx server/app.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "schema:generate-sql": "node scripts/generate-schema-sql.mjs",
    "prisma:generate": "prisma generate --schema=./server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./server/prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema=./server/prisma/schema.prisma"
  },
