{
  "name": "lei-system",
  "private": true,
  "version": "0.1.0",
  "description": "雷犀客服管理系统（重构版）— pnpm workspace",
  "scripts": {
    "============ 开发环境 ============": "",
    "dev": "pnpm -r --parallel dev",
    "dev:full": "pnpm --filter @lei/backend migrate && pnpm --filter @lei/backend db:seed && pnpm -r --parallel dev",
    "dev:frontend": "pnpm --filter @lei/frontend dev",
    "dev:backend": "pnpm --filter @lei/backend dev",
    "dev:seed": "pnpm --filter @lei/backend migrate && pnpm --filter @lei/backend db:seed",
    "redis:start": "\"D:\\Program Files\\FlyEnv-Data\\env\\redis\\redis-server.exe\" --port 6379 --requirepass 123456",

    "============ 构建 ============": "",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @lei/frontend build",
    "build:backend": "pnpm --filter @lei/backend build",

    "============ 测试 ============": "",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @lei/backend test",
    "test:frontend": "pnpm --filter @lei/frontend test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm test",

    "============ 重启 ============": "",
    "restart": "npx kill-port 4000 4001 && pnpm -r --parallel dev",
    "restart:frontend": "npx kill-port 4000 && pnpm dev:frontend",
    "restart:backend": "npx kill-port 4001 && pnpm dev:backend",

    "============ 重构（重新安装依赖 + 构建）============": "",
    "rebuild": "pnpm install --config.dangerouslyAllowAllBuilds=true && pnpm -r build",

    "============ Docker 部署 ============": "",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",

    "============ 生产部署（在生产服务器的仓库目录里执行，如 /root/LeiXiSystem）============": "",
    "prod:pull": "git pull --ff-only",
    "prod:build:backend": "docker compose -f docker-compose.prod.yml --env-file .env.production build backend",
    "prod:build:frontend": "docker compose -f docker-compose.prod.yml --env-file .env.production build frontend",
    "prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.production build backend && docker compose -f docker-compose.prod.yml --env-file .env.production build frontend",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:deploy": "git pull --ff-only && docker compose -f docker-compose.prod.yml --env-file .env.production build backend && docker compose -f docker-compose.prod.yml --env-file .env.production build frontend && docker compose -f docker-compose.prod.yml --env-file .env.production up -d",
    "prod:nginx:restart": "docker compose -f docker-compose.prod.yml --env-file .env.production restart nginx",
    "prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f backend",
    "prod:logs:frontend": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f frontend",
    "prod:ps": "docker compose -f docker-compose.prod.yml --env-file .env.production ps",
    "prod:health": "curl -fsS http://127.0.0.1:8088/api/v1/health",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}