# ===================================================================
# 雷犀管理系统 · Docker 环境变量模板
# ===================================================================
# 复制为 .env（项目根目录），docker-compose 自动加载
# 勿提交真实 .env（已被 .gitignore 忽略）
# 生成强随机密钥：openssl rand -hex 32
# ===================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=leixin_v2

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- 运行环境 ----
NODE_ENV=production

# ---- 后端安全 ----
# JWT 签名密钥（至少 8 位，生产环境请用强随机值）
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 过期时间（可选，默认 8h）
JWT_EXPIRES_IN=8h
# 预览签名密钥（KKFileView 附件预览，至少 16 位）
PREVIEW_SECRET=change-me-to-a-strong-random-secret

# ---- CORS ----
# 允许的前端 origin（逗号分隔，生产用真实域名）
CORS_ORIGIN=http://localhost:8088,http://localhost:3000

# ---- 阿里云 OSS（附件 / 报表导出，待接入）----
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=leixi-prod
# OSS_ACCESS_KEY=your-access-key
# OSS_ACCESS_SECRET=your-access-secret
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# ---- 邮件 SMTP（通知，待接入）----
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
