# --- 核心服务器配置 ---
NODE_ENV=development
SERVER_PORT=3002
PORT=3002
JWT_SECRET=

# --- 数据库配置 ---
DATABASE_URL="mysql://user:pass@localhost:3306/db_name"
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=pass
DB_NAME=db_name

# --- Redis 配置 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 上传与资产配置 ---
UPLOAD_SHARED_DIRECTORY=""
PUBLIC_URL="http://localhost:3002/api"
