# ============================================================================
# 雷犀管理系统 · 环境配置模板
# 拷贝本文件为 .env，填入实际值后使用。
# 本文件不含真实密钥，可安全提交到版本库。
# ============================================================================

# ===== 运行环境 =====
# 开发环境：development | 生产环境：production | 测试环境：test
NODE_ENV=development

# ===== 前端开发服务 =====
FRONTEND_PORT=4000
NEXT_PUBLIC_APP_PORT=4000
# 后端 API 代理地址（开发环境，Next.js rewrite 目标）
API_PROXY_TARGET=http://localhost:4001

# ===== 后端服务 =====
BACKEND_PORT=4001
# NestJS 默认读取 PORT 环境变量（main.ts 中 process.env.PORT）
PORT=4001
# JWT 密钥（生产环境必须改为 64 位以上随机字符串）
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# 文档预览签名密钥（生产环境必须改为 16 位以上随机字符串）
PREVIEW_SECRET=change-this-to-a-random-string-at-least-16-chars
# CORS 允许的域名（逗号分隔，生产环境改为实际域名）
CORS_ORIGIN=http://localhost:4000,http://localhost:8088

# ===== MySQL / 阿里云 RDS =====
# 本地开发
DATABASE_URL=mysql://root:root@localhost:3306/leixin_v2
# 生产环境（RDS）示例：
# DATABASE_URL=mysql://user:password@rds-host.xxx.rds.aliyuncs.com:3306/leixin_v2
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=leixin_v2

# ===== Redis =====
REDIS_URL=redis://:123456@localhost:6379
REDIS_PASSWORD=123456

# ===== 阿里云 OSS（对象存储，附件/报表导出）=====
# 生产环境必填
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY=your-access-key
OSS_ACCESS_SECRET=your-access-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ===== SMTP 邮件（通知服务，待接入）=====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password