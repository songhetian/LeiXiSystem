{
  "name": "@leixi/server",
  "version": "0.0.0",
  "private": true,
  "description": "雷犀内部管理系统后端：Fastify + TypeBox + Prisma + Redis + socket.io",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^8.0.1",
    "@fastify/type-provider-typebox": "^4.1.0",
    "@leixi/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@sinclair/typebox": "^0.34.13",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}