# Docker 构建排除文件
# 防止敏感文件和无关文件打入镜像

# 环境变量（含密钥，绝不可打入镜像）
.env
.env.*
!.env.docker.example

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp

# 测试产物
coverage
**/coverage
**/.nyc_output

# 文档（无需打入镜像）
docs
*.md
LICENSE

# 构建产物
**/dist
**/build
**/.next

# 日志
logs
*.log

# node_modules（host 的 Windows 版会破坏容器内 Linux 版）
node_modules
**/node_modules

# 导出产物（100+ xlsx/csv 文件，无需打入镜像）
backend/exports

# legacy 旧代码（已废弃，不应打入镜像）
legacy

# 原型/工具目录
prototypes
.workbuddy
.trae
.agents
.claude
