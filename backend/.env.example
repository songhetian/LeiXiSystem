# ===== 运行环境 =====
NODE_ENV=development
PORT=3001

# ===== 数据库（URL 方式，优先使用）=====
DATABASE_URL=mysql://username:password@localhost:3306/leixi_system

# ===== 数据库（分离变量方式，二选一）=====
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=username
# DB_PASSWORD=password
# DB_NAME=leixi_system

# ===== 认证（必填）=====
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ===== 预览签名密钥（知识库文件预览，可选）=====
PREVIEW_SECRET=your-preview-secret-key-min-16-chars

# ===== Redis（可选，用于缓存/会话/限流）=====
REDIS_URL=redis://localhost:6379

# ===== Redis（分离变量方式，二选一）=====
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ===== CORS（逗号分隔多域名）=====
CORS_ORIGIN=http://localhost:3000,http://localhost:8088

# ===== 阿里云 OSS（附件存储，可选）=====
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY=your-access-key-id
OSS_ACCESS_SECRET=your-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ===== 邮件 SMTP（通知，可选）=====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=notify@example.com
SMTP_PASS=your-smtp-password
