# 基础运行环境
NODE_ENV=development
APP_VERSION=1.0.0
PORT=3001

# 数据库连接
# 示例：mysql://user:password@localhost:3306/leixi_system
DATABASE_URL="mysql://root:password@localhost:3306/leixi_system"

# JWT 配置
# 生产环境必须设置为足够长、不可猜测的随机字符串
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=2h

# CORS
# 生产环境必须配置明确前端域名，不能使用 *
# 示例：https://hr.example.com
CORS_ORIGIN=http://localhost:5173

# 请求与上传限制
# BODY_LIMIT 默认 2MB，UPLOAD_FILE_SIZE 默认 10MB
BODY_LIMIT=2097152
UPLOAD_FILE_SIZE=10485760

# 限流
RATE_LIMIT_MAX=300
RATE_LIMIT_TIME_WINDOW="1 minute"

# 登录安全
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# SSO 安全白名单
# 多个域名用英文逗号分隔，例如：sso.example.com,login.example.com
SSO_ALLOWED_HOSTS=
ALLOW_PRIVATE_SSO_HOSTS=false

# Redis 缓存
# 留空则禁用 Redis，直接走数据库
# 示例：redis://localhost:6379 或 redis://:password@localhost:6379/0
REDIS_URL=
# 缓存默认过期时间（秒），默认 30 分钟
REDIS_CACHE_TTL=1800

# Prisma 查询日志
# 仅建议开发或排障时开启
PRISMA_QUERY_LOG=false
PRISMA_SLOW_QUERY_MS=300
