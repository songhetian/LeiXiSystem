# 雷犀管理系统 · 后端环境变量模板
# 复制为 .env 后填入真实值（勿提交真实 .env，已被 .gitignore 忽略）

# ---- 必填（envSchema 校验）----
# 数据库连接（MySQL 8）
DATABASE_URL="mysql://user:password@127.0.0.1:3306/leixin_v2"

# JWT 签名密钥（至少 8 位，生产环境请用强随机值）
JWT_SECRET="change-me-to-a-long-random-secret"

# ---- 可选（后续集成，当前未启用校验）----
# Redis（缓存 / 会话，待接入）
# REDIS_URL="redis://127.0.0.1:6379"

# 对象存储 OSS（附件 / 报表导出，待接入）
# OSS_REGION=""
# OSS_BUCKET=""
# OSS_ACCESS_KEY=""
# OSS_ACCESS_SECRET=""

# 邮件 SMTP（通知，待接入）
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# CORS 允许的源（逗号分隔，生产用真实前端域名）
# CORS_ORIGIN="http://localhost:3000"
