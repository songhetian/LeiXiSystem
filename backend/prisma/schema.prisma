generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  username        String     @unique @db.VarChar(50)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  realName        String     @map("real_name") @db.VarChar(50)
  email           String?    @unique @db.VarChar(100)
  phone           String?    @unique @db.VarChar(20)
  avatar          String?    @db.VarChar(1024)
  departmentId    Int?       @map("department_id")
  positionId      Int?       @map("position_id")
  status          String     @default("pending") @db.VarChar(20)
  isDeptManager   Boolean    @default(false) @map("is_department_manager")
  lastLogin       DateTime?  @map("last_login")
  sessionToken    String?    @map("session_token") @db.VarChar(500)
  sessionCreatedAt DateTime?  @map("session_created_at")
  sessionVersion  Int        @default(1) @map("session_version")
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  loginLockedUntil DateTime? @map("login_locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  department      Department? @relation("UserDept", fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employee        Employee?
  userRoles       UserRole[]
  managedDepts    Department[] @relation("DeptManager")
  schedules       Schedule[] @relation("scheduleUser")
  createdSchedules Schedule[] @relation("creator")
  scheduleConfirmations ScheduleConfirmation[] @relation("ScheduleConfirmUser")
  scheduleAppealsCreated ScheduleAppeal[] @relation("ScheduleAppealUser")
  scheduleAppealsHandled ScheduleAppeal[] @relation("ScheduleAppealHandler")
  attendanceRecords AttendanceRecord[]
  leaveRequests   LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  reimbursements  Reimbursement[]
  notifications   Notification[]
  payslipPassword PayslipPassword?
  attendanceCheckins AttendanceCheckin[]
  attendanceDailyRecords AttendanceDaily[]
  attendanceMonthlyRecords AttendanceMonthly[]
  payrollRunsCreated PayrollRun[] @relation("PayrollRunCreator")
  payrollRunsApproved PayrollRun[] @relation("PayrollRunApprover")
  payslips       Payslip[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  payrollAdjustmentsCreated PayrollAdjustment[] @relation("PayrollAdjustmentCreator")
  payrollAdjustmentsApproved PayrollAdjustment[] @relation("PayrollAdjustmentApprover")
  payslipDisputesCreated PayslipDispute[] @relation("PayslipDisputeCreator")
  payslipDisputesHandled PayslipDispute[] @relation("PayslipDisputeHandler")
  leaveApprovals         LeaveApprovalRecord[] @relation("LeaveApprovalApprover")
  overtimeApprovals      OvertimeApprovalRecord[] @relation("OvertimeApprovalApprover")
  reimbursementApprovals ReimbursementApproval[] @relation("ReimbursementApprovalApprover")
  approvalRecords        ApprovalRecord[] @relation("ApprovalRecordApprover")
  attendanceExceptionsResolved AttendanceException[] @relation("AttendanceExceptionApprover")
  attendanceExceptionRulesCreated AttendanceExceptionRule[] @relation("AttendanceExceptionRuleCreator")
  overtimeTypesCreated OvertimeType[] @relation("OvertimeTypeCreator")
  scheduleTemplatesCreated ScheduleTemplate[] @relation("ScheduleTemplateCreator")
  lifecycleEventsCreated EmployeeLifecycleEvent[] @relation("LifecycleEventCreator")
  onboardingTasksAssigned OnboardingTask[] @relation("OnboardingTaskAssignee")
  onboardingTasksCreated OnboardingTask[] @relation("OnboardingTaskCreator")
  onboardingFlowsCreated OnboardingFlow[] @relation("OnboardingFlowCreator")
  offboardingTasksAssigned OffboardingTask[] @relation("OffboardingTaskAssignee")
  offboardingTasksCreated OffboardingTask[] @relation("OffboardingTaskCreator")
  assetAssignmentsOperated AssetAssignment[] @relation("AssetAssignmentOperator")
  helpdeskTicketsCreated HelpdeskTicket[] @relation("HelpdeskTicketCreator")
  helpdeskTicketsAssigned HelpdeskTicket[] @relation("HelpdeskTicketAssignee")
  helpdeskComments HelpdeskTicketComment[]
  recruitmentRequestsCreated RecruitmentRequest[] @relation("RecruitmentRequestCreator")
  jobOpeningsCreated JobOpening[] @relation("JobOpeningCreator")
  candidatesCreated Candidate[] @relation("CandidateCreator")
  interviewRoundsInterviewer InterviewRound[] @relation("InterviewInterviewer")
  offersCreated Offer[] @relation("OfferCreator")
  performanceCyclesCreated PerformanceCycle[] @relation("PerformanceCycleCreator")
  performanceGoalsCreated PerformanceGoal[] @relation("PerformanceGoalCreator")
  performanceReviewsReviewer PerformanceReview[] @relation("PerformanceReviewReviewer")
  performanceReviewsCreated PerformanceReview[] @relation("PerformanceReviewCreator")
  trainingCoursesCreated TrainingCourse[] @relation("TrainingCourseCreator")
  trainingSessionsInstructor TrainingSession[] @relation("TrainingSessionInstructor")
  trainingSessionsCreated TrainingSession[] @relation("TrainingSessionCreator")
  swapRequestsAsRequester ShiftSwapRequest[] @relation("SwapRequester")
  swapRequestsAsTarget ShiftSwapRequest[] @relation("SwapTarget")
  swapRequestsAsApprover ShiftSwapRequest[] @relation("SwapApprover")
  secondmentsCreated EmployeeSecondment[] @relation("SecondmentCreator")
  exportTasks ExportTask[]
  exportTemplates ExportTemplate[]
  announcementsCreated SystemAnnouncement[] @relation("AnnouncementCreator")
  announcementReads AnnouncementRead[]

  @@index([departmentId, status])
  @@index([status])
  @@index([loginLockedUntil])
  @@map("users")
}

model PayslipPassword {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  isDefault      Boolean   @default(true) @map("is_default")
  lastChangedAt  DateTime  @default(now()) @map("last_changed_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payslip_passwords")
}

model Employee {
  id                  Int       @id @default(autoincrement())
  userId              Int       @unique @map("user_id")
  employeeNo          String    @unique @map("employee_no") @db.VarChar(20)
  hireDate            DateTime  @map("hire_date")
  salary              Decimal?  @db.Decimal(10, 2)
  status              String    @default("active") @db.VarChar(20)
  gender              String?   @db.VarChar(10)
  birthDate           DateTime? @map("birth_date") @db.Date
  idCardNo            String?   @map("id_card_no") @db.VarChar(20)
  nationality         String?   @db.VarChar(50)
  maritalStatus       String?   @map("marital_status") @db.VarChar(20)
  bankName            String?   @map("bank_name") @db.VarChar(100)
  bankAccountNo       String?   @map("bank_account_no") @db.VarChar(50)
  terminationDate     DateTime? @map("termination_date") @db.Date
  terminationType     String?   @map("termination_type") @db.VarChar(50)
  terminationReason   String?   @map("termination_reason") @db.VarChar(500)
  probationEndDate    DateTime? @map("probation_end_date") @db.Date
  contractSignDate    DateTime? @map("contract_sign_date") @db.Date
  emergencyContact    String?   @map("emergency_contact") @db.VarChar(50)
  emergencyPhone      String?   @map("emergency_phone") @db.VarChar(20)
  address             String?   @db.VarChar(200)
  education           String?   @db.VarChar(20)
  skills              String?
  remark              String?
  rating              Int       @default(1)
  maxTickets          Int       @default(5) @map("max_tickets")
  isOnduty            Boolean   @default(false) @map("is_onduty")
  supervisorId        Int?      @map("supervisor_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supervisor          Employee? @relation("SupervisorSubordinate", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates        Employee[] @relation("SupervisorSubordinate")
  emergencyContacts   EmployeeEmergencyContact[]
  changes             EmployeeChange[]
  leaveRequests       LeaveRequest[]
  overtimeRequests    OvertimeRequest[]
  reimbursements      Reimbursement[]
  attendances         AttendanceRecord[]
  schedules           Schedule[]
  vacationBalances    VacationBalance[]
  attendanceCheckins  AttendanceCheckin[]
  attendanceDailyRecords AttendanceDaily[]
  attendanceMonthlyRecords AttendanceMonthly[]
  attendanceExceptions AttendanceException[]
  salaryAssignments   SalaryAssignment[]
  payslips            Payslip[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  payrollAdjustments  PayrollAdjustment[]
  payslipDisputes     PayslipDispute[]
  lifecycleEvents     EmployeeLifecycleEvent[]
  onboardingTasks     OnboardingTask[]
  onboarding          EmployeeOnboarding?
  offboardingTasks    OffboardingTask[]
  documents           EmployeeDocument[]
  contracts           EmployeeContract[]
  assignedAssets      AssetItem[]
  assetAssignments    AssetAssignment[]
  helpdeskTickets    HelpdeskTicket[]
  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  trainingEnrollments TrainingEnrollment[]
  schedulePreference  EmployeeSchedulePreference?
  secondments         EmployeeSecondment[]
  tagAssignments      EmployeeTagAssignment[]

  @@index([status])
  @@map("employees")
}

model EmployeeEmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  name         String   @db.VarChar(50)
  relationship String   @db.VarChar(50)
  phone        String   @db.VarChar(20)
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  parentId    Int?      @map("parent_id")
  description String?
  managerId   Int?      @map("manager_id")
  status      String    @default("active") @db.VarChar(20)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      Department? @relation("parentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("parentChildren")
  manager     User?       @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]      @relation("UserDept")
  positions   Position[]
  shifts      Shift[]
  recruitmentRequests RecruitmentRequest[]
  jobOpenings JobOpening[]
  scheduleRules ScheduleRule[]
  secondmentsFrom EmployeeSecondment[] @relation("SecondmentFrom")
  secondmentsTo EmployeeSecondment[] @relation("SecondmentTo")
  expenseStandards ExpenseStandard[]
  annualBudgets AnnualBudget[]
  onboardingFlows OnboardingFlow[]
  attendanceExceptionRules AttendanceExceptionRule[]
  attendanceLocations AttendanceLocation[]
  overtimeTypes OvertimeType[]
  scheduleTemplates ScheduleTemplate[]

  @@map("departments")
}

model Position {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  departmentId   Int       @map("department_id")
  description    String?
  requirements   String?
  responsibilities String?
  salaryMin      Decimal?  @map("salary_min") @db.Decimal(10, 2)
  salaryMax      Decimal?  @map("salary_max") @db.Decimal(10, 2)
  status         String    @default("active") @db.VarChar(20)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users          User[]
  recruitmentRequests RecruitmentRequest[]
  jobOpenings    JobOpening[]
  onboardingFlows OnboardingFlow[]

  @@map("positions")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  level       Int       @default(1)
  isSystem    Boolean   @default(false) @map("is_system")
  canViewAllDepts Boolean @default(false) @map("can_view_all_departments")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userRoles   UserRole[]
  rolePermissions RolePermission[]
  dataScopes  RoleDataScope[]

  @@map("roles")
}

model RoleDataScope {
  id            Int      @id @default(autoincrement())
  roleId        Int      @map("role_id")
  scopeType     String   @default("self") @map("scope_type") @db.VarChar(50)
  departmentIds Json?    @map("department_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId])
  @@map("role_data_scopes")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  code        String    @unique @db.VarChar(50)
  resource    String    @db.VarChar(50)
  action      String    @db.VarChar(50)
  description String?
  module      String    @db.VarChar(50)
  parentId    Int?      @map("parent_id")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      Permission? @relation("permissionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Permission[] @relation("permissionTree")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Shift {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(50)
  code         String    @unique @db.VarChar(50)
  departmentId Int?      @map("department_id")
  startTime    String    @map("start_time") @db.VarChar(10)
  endTime      String    @map("end_time") @db.VarChar(10)
  workHours    Decimal   @map("work_hours") @db.Decimal(4, 2)
  isFlexible   Boolean   @default(false) @map("is_flexible")
  isCrossDay   Boolean   @default(false) @map("is_cross_day")
  beginCheckinMinutes  Int @default(60) @map("begin_checkin_minutes")
  allowCheckoutMinutes Int @default(60) @map("allow_checkout_minutes")
  lateGraceMinutes     Int @default(0) @map("late_grace_minutes")
  earlyGraceMinutes    Int @default(0) @map("early_grace_minutes")
  color        String?   @db.VarChar(20)
  description  String?
  status       String    @default("active") @db.VarChar(20)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules    Schedule[]
  attendanceRecords AttendanceRecord[]
  dailyRecords AttendanceDaily[]
  preferredBy  EmployeeSchedulePreference[]

  @@map("shifts")
}

model Schedule {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  employeeId    Int       @map("employee_id")
  shiftId       Int       @map("shift_id")
  scheduleDate  DateTime  @map("schedule_date") @db.Date
  status        String    @default("normal") @db.VarChar(20)
  note          String?
  source        String    @default("manual") @map("source") @db.VarChar(20)  // manual/auto/swap
  ruleId        Int?      @map("rule_id")
  confidence    Decimal?  @map("confidence") @db.Decimal(5, 4)
  conflictWarnings String? @map("conflict_warnings") @db.Text
  versionId       Int?      @map("version_id")
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation("scheduleUser", fields: [userId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  creator       User?     @relation("creator", fields: [createdBy], references: [id], onDelete: SetNull)
  rule          ScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  swapRequesterSchedule ShiftSwapRequest? @relation("SwapRequesterSchedule")
  swapTargetSchedule     ShiftSwapRequest? @relation("SwapTargetSchedule")
  confirmation           ScheduleConfirmation?
  appeals               ScheduleAppeal[]

  @@unique([userId, scheduleDate])
  @@index([scheduleDate, userId])
  @@index([scheduleDate, shiftId])
  @@index([employeeId, scheduleDate])
  @@index([ruleId])
  @@index([versionId])
  @@map("schedules")
}

// 排班确认记录
model ScheduleConfirmation {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  scheduleId    Int      @unique @map("schedule_id")
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  status        String   @default("pending") @db.VarChar(20)  // pending/confirmed/appealed/auto_confirmed
  confirmAt     DateTime? @map("confirm_at")
  rejectReason  String?  @map("reject_reason") @db.VarChar(500)
  autoConfirmDeadline DateTime? @map("auto_confirm_deadline") @db.Date
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation("ScheduleConfirmUser", fields: [userId], references: [id], onDelete: Cascade)
  schedule      Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart, periodEnd])
  @@index([status])
  @@map("schedule_confirmations")
}

// 排班申诉记录
model ScheduleAppeal {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  scheduleId      Int      @map("schedule_id")
  reason          String   @db.VarChar(500)
  expectedDate    DateTime? @map("expected_date") @db.Date
  expectedShiftId Int?     @map("expected_shift_id")
  expectedShiftName String? @map("expected_shift_name") @db.VarChar(100)
  status          String   @default("pending") @db.VarChar(20)  // pending/approved/rejected
  handlerId       Int?     @map("handler_id")
  handlerNote     String?  @map("handler_note") @db.VarChar(500)
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User      @relation("ScheduleAppealUser", fields: [userId], references: [id], onDelete: Cascade)
  schedule        Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  handler         User?     @relation("ScheduleAppealHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status])
  @@map("schedule_appeals")
}

// 排班规则模板
model ScheduleRule {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(100)
  code                 String    @unique @db.VarChar(50)
  departmentId         Int?      @map("department_id")
  shiftIds             String    @map("shift_ids")  // 逗号分隔的班次ID
  pattern              String?   @db.Text         // JSON排班模式配置
  
  // 合规规则
  maxWorkHoursPerWeek    Decimal? @map("max_work_hours_week") @db.Decimal(5, 2)
  maxConsecutiveDays     Int?     @map("max_consecutive_days")
  minRestHoursBetween    Int?     @map("min_rest_hours")
  maxNightShiftsPerWeek Int?     @map("max_night_shifts_week")
  
  // 智能参数
  priority            Int       @default(0)
  fairnessWeight      Int       @default(50)
  preferenceEnabled   Boolean   @default(true) @map("preference_enabled")
  
  status              String    @default("active") @db.VarChar(20)
  sortOrder           Int       @default(0) @map("sort_order")
  holidayListId       Int?      @map("holiday_list_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  department          Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules           Schedule[]
  holidayList         HolidayList? @relation(fields: [holidayListId], references: [id], onDelete: SetNull)

  @@index([departmentId, status])
  @@map("schedule_rules")
}

// 排班模板（周期模式）
model ScheduleTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  departmentId Int?    @map("department_id")
  cycleDays   Int      @default(7) @map("cycle_days")
  repeatType  String   @default("weekday") @map("repeat_type") @db.VarChar(20)
  description String?  @db.VarChar(500)
  status      String   @default("active") @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator     User?       @relation("ScheduleTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items       ScheduleTemplateItem[]

  @@index([departmentId, status])
  @@map("schedule_templates")
}

model ScheduleTemplateItem {
  id          Int      @id @default(autoincrement())
  templateId  Int      @map("template_id")
  dayIndex    Int      @map("day_index")
  shiftIds    String   @map("shift_ids")
  weekday     Int?     // 0-6, repeatType=weekday时使用

  template    ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayIndex])
  @@index([templateId, dayIndex])
  @@map("schedule_template_items")
}

// 员工排班偏好
model EmployeeSchedulePreference {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @unique @map("employee_id")
  preferredShiftId Int?      @map("preferred_shift_id")
  preferredDays    String?   @map("preferred_days")    // 逗号分隔 "1,2,3,4,5"
  avoidDays        String?   @map("avoid_days")
  avoidDates       String?   @map("avoid_dates")       // 避开特定日期，逗号分隔
  notes            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  preferredShift   Shift?    @relation(fields: [preferredShiftId], references: [id], onDelete: SetNull)

  @@map("employee_schedule_preferences")
}

// 换班申请
model ShiftSwapRequest {
  id                Int       @id @default(autoincrement())
  requestNo         String    @unique @map("request_no")
  requesterId       Int       @map("requester_id")
  targetId          Int       @map("target_id")
  requesterScheduleId Int     @unique @map("requester_schedule_id")
  targetScheduleId  Int       @unique @map("target_schedule_id")
  reason            String?   @db.VarChar(500)
  status            String    @default("pending") @db.VarChar(20)
  approveRemark     String?   @map("approve_remark")
  approvedBy        Int?      @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  requester         User      @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target            User      @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  requesterSchedule Schedule  @relation("SwapRequesterSchedule", fields: [requesterScheduleId], references: [id], onDelete: Cascade)
  targetSchedule    Schedule  @relation("SwapTargetSchedule", fields: [targetScheduleId], references: [id], onDelete: Cascade)
