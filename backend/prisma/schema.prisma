model VacationType {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(50)
  code            String    @unique @db.VarChar(50)
  totalDays       Decimal   @default(0) @map("total_days") @db.Decimal(5, 1)
  unit            String    @default("day") @db.VarChar(10)
  isCarryOver     Boolean   @default(false) @map("is_carry_over")
  carryOverDays   Decimal   @default(0) @map("carry_over_days") @db.Decimal(5, 1)
  isPaid          Boolean   @default(true) @map("is_paid")
  sortOrder       Int       @default(0) @map("sort_order")
  status          String    @default("active") @db.VarChar(20)
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  balances        VacationBalance[]

  @@map("vacation_types")
}

model VacationBalance {
  id           Int     @id @default(autoincrement())
  employeeId   Int     @map("employee_id")
  vacationTypeId Int   @map("vacation_type_id")
  year         Int
  total        Decimal @db.Decimal(5, 1)
  used         Decimal @default(0) @db.Decimal(5, 1)
  balance      Decimal @db.Decimal(5, 1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vacationType VacationType @relation(fields: [vacationTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, vacationTypeId, year])
  @@map("vacation_balances")
}

model EmployeeChange {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  changeType   String    @map("change_type") @db.VarChar(50)
  oldValue     Json?      @map("old_value")
  newValue     Json?      @map("new_value")
  reason       String?
  effectiveDate DateTime  @map("effective_date") @db.Date
  operatorId   Int?      @map("operator_id")
  status       String    @default("completed") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_changes")
}

model EmployeeLifecycleEvent {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  eventType     String   @map("event_type") @db.VarChar(50)
  title         String   @db.VarChar(100)
  description   String?
  effectiveDate DateTime @map("effective_date") @db.Date
  status        String   @default("pending") @db.VarChar(30)
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator       User?    @relation("LifecycleEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@index([eventType, status])
  @@map("employee_lifecycle_events")
}

model OnboardingTask {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  title       String   @db.VarChar(100)
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  status      String   @default("pending") @db.VarChar(30)
  assignedTo  Int?     @map("assigned_to")
  createdBy   Int?     @map("created_by")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("OnboardingTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator     User?    @relation("OnboardingTaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([assignedTo, status])
  @@map("onboarding_tasks")
}

// 入职流程模板
model OnboardingFlow {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(100)
  description  String?
  departmentId Int?              @map("department_id")
  positionId   Int?              @map("position_id")
  status       String            @default("active") @db.VarChar(20)
  isDefault    Boolean           @default(false) @map("is_default")
  sortOrder    Int               @default(0) @map("sort_order")
  createdBy    Int?              @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  steps        OnboardingFlowStep[]
  employeeOnboardings EmployeeOnboarding[]
  creator      User?             @relation("OnboardingFlowCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?         @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([departmentId, positionId])
  @@map("onboarding_flows")
}

// 入职流程步骤
model OnboardingFlowStep {
  id          Int      @id @default(autoincrement())
  flowId      Int      @map("flow_id")
  title       String   @db.VarChar(100)
  description String?
  stepOrder   Int      @map("step_order")
  type        String   @db.VarChar(30)  // document/task/meeting/training
  assigneeRole String? @map("assignee_role") @db.VarChar(50)
  departmentId Int?    @map("department_id")
  dueDays     Int      @default(1) @map("due_days")
  required    Boolean  @default(true)
  taskTemplate String?  // JSON模板，用于生成OnboardingTask
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  flow        OnboardingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, stepOrder])
  @@map("onboarding_flow_steps")
}

// 员工入职记录
model EmployeeOnboarding {
  id              Int      @id @default(autoincrement())
  employeeId      Int      @unique @map("employee_id")
  flowId          Int?     @map("flow_id")
  status          String   @default("in_progress") @db.VarChar(20) // in_progress/completed/cancelled
  startDate       DateTime @map("start_date") @db.Date
  completedDate   DateTime? @map("completed_date") @db.Date
  currentStep     Int      @default(0) @map("current_step")
  totalSteps      Int      @default(0) @map("total_steps")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  flow            OnboardingFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@map("employee_onboarding")
}

model OffboardingTask {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  title       String   @db.VarChar(100)
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  status      String   @default("pending") @db.VarChar(30)
  assignedTo  Int?     @map("assigned_to")
  createdBy   Int?     @map("created_by")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignee    User?    @relation("OffboardingTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator     User?    @relation("OffboardingTaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([assignedTo, status])
  @@map("offboarding_tasks")
}

model EmployeeDocument {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  name        String   @db.VarChar(100)
  documentType String  @map("document_type") @db.VarChar(50)
  fileUrl     String?  @map("file_url") @db.VarChar(500)
  status      String   @default("active") @db.VarChar(30)
  expiresAt   DateTime? @map("expires_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, documentType])
  @@index([status, expiresAt])
  @@map("employee_documents")
}

model EmployeeContract {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  contractNo  String   @map("contract_no") @db.VarChar(100)
  contractType String  @map("contract_type") @db.VarChar(50)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  status      String   @default("active") @db.VarChar(30)
  fileUrl     String?  @map("file_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([contractNo])
  @@index([employeeId, status])
  @@index([endDate])
  @@map("employee_contracts")
}

model AssetCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?
  status      String   @default("active") @db.VarChar(30)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assets      AssetItem[]

  @@index([status, sortOrder])
  @@map("asset_categories")
}

model AssetItem {
  id                Int      @id @default(autoincrement())
  assetNo           String   @unique @map("asset_no") @db.VarChar(100)
  name              String   @db.VarChar(100)
  categoryId        Int      @map("category_id")
  assetType         String   @default("IT") @map("asset_type") @db.VarChar(30)
  brand             String?  @db.VarChar(100)
  model             String?  @db.VarChar(100)
  serialNo          String?  @map("serial_no") @db.VarChar(100)
  purchaseDate      DateTime? @map("purchase_date") @db.Date
  purchaseAmount    Decimal? @map("purchase_amount") @db.Decimal(10, 2)
  location          String?  @db.VarChar(100)
  status            String   @default("idle") @db.VarChar(30)
  currentEmployeeId Int?     @map("current_employee_id")
  remark            String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category          AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currentEmployee   Employee? @relation(fields: [currentEmployeeId], references: [id], onDelete: SetNull)
  assignments       AssetAssignment[]
  components        AssetComponent[]
  operations        AssetOperation[]

  @@index([categoryId, status])
  @@index([currentEmployeeId, status])
  @@index([status, createdAt])
  @@map("asset_items")
}

model AssetAssignment {
  id          Int      @id @default(autoincrement())
  assetId     Int      @map("asset_id")
  employeeId  Int      @map("employee_id")
  action      String   @db.VarChar(30)
  assignedAt  DateTime @default(now()) @map("assigned_at")
  returnedAt  DateTime? @map("returned_at")
  operatorId  Int?     @map("operator_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  asset       AssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  operator    User?    @relation("AssetAssignmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([assetId, assignedAt])
  @@index([employeeId, assignedAt])
  @@index([action, assignedAt])
  @@map("asset_assignments")
}

model HelpdeskCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  description String?
  status      String   @default("active") @db.VarChar(30)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tickets     HelpdeskTicket[]

  @@index([status, sortOrder])
  @@map("helpdesk_categories")
}

model HelpdeskTicket {
  id          Int       @id @default(autoincrement())
  ticketNo    String    @unique @map("ticket_no") @db.VarChar(50)
  title       String    @db.VarChar(200)
  description String?
  categoryId  Int       @map("category_id")
  priority    String    @default("medium") @db.VarChar(30)
  status      String    @default("open") @db.VarChar(30)
  createdBy   Int       @map("created_by")
  assignedTo  Int?      @map("assigned_to")
  employeeId  Int?       @map("employee_id")
  sourceType  String?   @map("source_type") @db.VarChar(50)
  sourceId    Int?      @map("source_id")
  slaDeadline DateTime? @map("sla_deadline")
  resolution  String?   @db.VarChar(1000)
  resolvedAt  DateTime? @map("resolved_at")
  closedAt    DateTime? @map("closed_at")
  feedbackRating Int?   @map("feedback_rating")

  // P0新增: SLA + 满意度 + 客户关联
  slaId              Int?      @map("sla_id")
  slaStatus          String?   @map("sla_status") @db.VarChar(50)
  firstResponseDue   DateTime? @map("first_response_due")
  resolutionDue      DateTime? @map("resolution_due")
  firstRespondedAt   DateTime? @map("first_responded_at")
  slaBreachAlertSent Boolean   @default(false) @map("sla_breach_alert_sent")
  satisfactionRating      Int?       @map("satisfaction_rating")
  satisfactionComment     String?    @map("satisfaction_comment") @db.VarChar(500)
  satisfactionSubmittedAt DateTime?  @map("satisfaction_submitted_at")
  customerId        Int?      @map("customer_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category    HelpdeskCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator     User @relation("HelpdeskTicketCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee    User? @relation("HelpdeskTicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  comments    HelpdeskTicketComment[]
  sla         HelpdeskSLA? @relation(fields: [slaId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([createdBy, status])
  @@index([assignedTo, status])
  @@index([employeeId, status])
  @@index([categoryId, status])
  @@index([priority, status])
  @@index([slaStatus])
  @@index([customerId, status])
  @@map("helpdesk_tickets")
}

model HelpdeskTicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  userId    Int      @map("user_id")
  content   String
  isInternal Boolean @default(false) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at")

  ticket    HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_ticket_comments")
}

model RecruitmentRequest {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(200)
  departmentId Int      @map("department_id")
  positionId   Int?     @map("position_id")
  headcount    Int      @default(1)
  reason       String?
  priority     String   @default("medium") @db.VarChar(30)
  status       String   @default("draft") @db.VarChar(30)
  createdBy    Int?     @map("created_by")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position     Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  creator      User? @relation("RecruitmentRequestCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  jobOpenings  JobOpening[]

  @@index([departmentId, status])
  @@index([status, priority])
  @@map("recruitment_requests")
}

model JobOpening {
  id           Int      @id @default(autoincrement())
  requestId    Int?     @map("request_id")
  title        String   @db.VarChar(200)
  departmentId Int      @map("department_id")
  positionId   Int?     @map("position_id")
  headcount    Int      @default(1)
  description  String?
  requirements String?
  status       String   @default("open") @db.VarChar(30)
  publishedAt  DateTime? @map("published_at")
  closedAt     DateTime? @map("closed_at")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  request      RecruitmentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position     Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  creator      User? @relation("JobOpeningCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  candidates   Candidate[]

  @@index([departmentId, status])
  @@index([requestId, status])
  @@map("job_openings")
}

model Candidate {
  id           Int       @id @default(autoincrement())
  jobOpeningId Int       @map("job_opening_id")
  name         String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(100)
  gender       String?   @db.VarChar(10)
  birthDate    DateTime? @map("birth_date") @db.Date
  idCardNo     String?   @map("id_card_no") @db.VarChar(20)
  nationality  String?   @db.VarChar(50)
  maritalStatus String?  @map("marital_status") @db.VarChar(20)
  address      String?   @db.VarChar(500)
  expectedSalary Decimal? @map("expected_salary") @db.Decimal(12, 2)
  currentSalary  Decimal? @map("current_salary") @db.Decimal(12, 2)
  noticePeriodDays Int?   @map("notice_period_days")
  source       String?   @db.VarChar(50)
  resumeUrl    String?   @map("resume_url") @db.VarChar(500)
  status       String    @default("new") @db.VarChar(30)
  rating       Int       @default(0)
  note         String?
  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  jobOpening  JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  creator     User? @relation("CandidateCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  interviews  InterviewRound[]
  offers      Offer[]

  @@index([jobOpeningId, status])
  @@index([phone])
  @@index([email])
  @@map("candidates")
}

model InterviewRound {
  id          Int      @id @default(autoincrement())
  candidateId Int     @map("candidate_id")
  roundName   String  @map("round_name") @db.VarChar(100)
  interviewAt DateTime? @map("interview_at")
  interviewerId Int?  @map("interviewer_id")
  result      String  @default("pending") @db.VarChar(30)
  feedback    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer User? @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([candidateId, result])
  @@index([interviewerId, interviewAt])
  @@map("interview_rounds")
}

model Offer {
  id          Int      @id @default(autoincrement())
  candidateId Int     @map("candidate_id")
  offerNo     String  @unique @map("offer_no") @db.VarChar(50)
  salary      Decimal? @db.Decimal(10, 2)
  startDate   DateTime? @map("start_date") @db.Date
  status      String  @default("draft") @db.VarChar(30)
  createdBy   Int?    @map("created_by")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  creator     User? @relation("OfferCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([candidateId, status])
  @@index([status, startDate])
  @@map("offers")
}

model PerformanceCycle {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  cycleType   String   @default("quarter") @map("cycle_type") @db.VarChar(30)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  status      String   @default("draft") @db.VarChar(30)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator     User? @relation("PerformanceCycleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  goals       PerformanceGoal[]
  reviews     PerformanceReview[]

  @@index([status, startDate])
  @@map("performance_cycles")
}

model PerformanceGoal {
  id          Int      @id @default(autoincrement())
  cycleId     Int      @map("cycle_id")
  employeeId  Int      @map("employee_id")
  title       String   @db.VarChar(200)
  description String?
  metric      String?  @db.VarChar(200)
  targetValue Decimal? @map("target_value") @db.Decimal(10, 2)
  weight      Decimal  @default(0) @db.Decimal(5, 2)
  progress    Decimal  @default(0) @db.Decimal(5, 2)
  status      String   @default("active") @db.VarChar(30)
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  creator     User? @relation("PerformanceGoalCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([cycleId, employeeId])
  @@index([employeeId, status])
  @@map("performance_goals")
}

model PerformanceReview {
  id          Int       @id @default(autoincrement())
  cycleId     Int       @map("cycle_id")
  employeeId  Int       @map("employee_id")
  reviewerId   Int?      @map("reviewer_id")
  selfScore    Decimal?  @map("self_score") @db.Decimal(5, 2)
  managerScore Decimal? @map("manager_score") @db.Decimal(5, 2)
  finalScore   Decimal? @map("final_score") @db.Decimal(5, 2)
  rating       String?  @db.VarChar(30)
  selfComment  String?  @map("self_comment")
  managerComment String? @map("manager_comment")
  developmentPlan String? @map("development_plan") @db.VarChar(1000)
  promotionRecommendation String? @map("promotion_recommendation") @db.VarChar(20)
  status       String   @default("draft") @db.VarChar(30)
  createdBy    Int?      @map("created_by")
  submittedAt  DateTime? @map("submitted_at")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    User? @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  creator     User? @relation("PerformanceReviewCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items       PerformanceReviewItem[]

  @@unique([cycleId, employeeId])
  @@index([employeeId, status])
  @@index([reviewerId, status])
  @@map("performance_reviews")
}

model PerformanceReviewItem {
  id          Int      @id @default(autoincrement())
  reviewId    Int      @map("review_id")
  dimension   String   @db.VarChar(100)
  score       Decimal  @db.Decimal(5, 2)
