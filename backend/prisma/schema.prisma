// ===== 绩效管理（performance） =====
enum PerformanceCycleStatus {
  draft
  active
  closed
}

model PerformanceCycle {
  id                     Int                   @id @default(autoincrement())
  name                   String                @map("name") @db.VarChar(100)
  type                   String                @map("type") @db.VarChar(20)
  startDate              DateTime              @map("start_date") @db.Date
  endDate                DateTime              @map("end_date") @db.Date
  selfReviewDeadline     DateTime?             @map("self_review_deadline") @db.Date
  managerReviewDeadline  DateTime?             @map("manager_review_deadline") @db.Date
  calibrationDeadline    DateTime?             @map("calibration_deadline") @db.Date
  status                 PerformanceCycleStatus @default(draft)
  goals                  PerformanceGoal[]
  reviews                PerformanceReview[]
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate])
  @@map("performance_cycles")
}

model PerformanceGoal {
  id          Int          @id @default(autoincrement())
  cycleId     Int          @map("cycle_id")
  cycle       PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  Int          @map("employee_id")
  title       String       @map("title") @db.VarChar(200)
  description String?      @map("description") @db.Text
  weight      Decimal      @default(0) @map("weight") @db.Decimal(5, 2)
  targetValue String?      @map("target_value") @db.VarChar(200)
  actualValue String?      @map("actual_value") @db.VarChar(200)
  progress    Int          @default(0) @map("progress")
  status      String       @default("pending") @map("status") @db.VarChar(20)
  dueDate     DateTime?    @map("due_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([cycleId])
  @@index([employeeId])
  @@map("performance_goals")
}

model PerformanceReview {
  id                       Int                @id @default(autoincrement())
  cycleId                  Int                @map("cycle_id")
  cycle                    PerformanceCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId               Int                @map("employee_id")
  reviewerId               Int?               @map("reviewer_id")
  selfScore                Decimal?           @map("self_score") @db.Decimal(5, 2)
  managerScore             Decimal?           @map("manager_score") @db.Decimal(5, 2)
  finalScore               Decimal?           @map("final_score") @db.Decimal(5, 2)
  rating                   String?            @map("rating") @db.VarChar(20)
  status                   String             @default("pending") @map("status") @db.VarChar(20)
  selfComment              String?            @map("self_comment") @db.Text
  managerComment           String?            @map("manager_comment") @db.Text
  developmentPlan          String?            @map("development_plan") @db.Text
  promotionRecommendation  Boolean?           @map("promotion_recommendation")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@index([cycleId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

