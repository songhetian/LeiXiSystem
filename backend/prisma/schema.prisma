generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int        @id @default(autoincrement())
  username        String     @unique @db.VarChar(50)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  realName        String     @map("real_name") @db.VarChar(50)
  email           String?    @unique @db.VarChar(100)
  phone           String?    @unique @db.VarChar(20)
  avatar          String?    @db.VarChar(1024)
  departmentId    Int?       @map("department_id")
  positionId      Int?       @map("position_id")
  status          String     @default("pending") @db.VarChar(20)
  isDeptManager   Boolean    @default(false) @map("is_department_manager")
  lastLogin       DateTime?  @map("last_login")
  sessionToken    String?    @map("session_token") @db.VarChar(500)
  sessionCreatedAt DateTime?  @map("session_created_at")
  sessionVersion  Int        @default(1) @map("session_version")
  failedLoginAttempts Int    @default(0) @map("failed_login_attempts")
  loginLockedUntil DateTime? @map("login_locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  department      Department? @relation("UserDept", fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employee        Employee?
  userRoles       UserRole[]
  managedDepts    Department[] @relation("DeptManager")
  schedules       Schedule[] @relation("scheduleUser")
  createdSchedules Schedule[] @relation("creator")
  attendanceRecords AttendanceRecord[]
  leaveRequests   LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  reimbursements  Reimbursement[]
  notifications   Notification[]
  payslipPassword PayslipPassword?
  attendanceCheckins AttendanceCheckin[]
  attendanceDailyRecords AttendanceDaily[]
  attendanceMonthlyRecords AttendanceMonthly[]
  payrollRunsCreated PayrollRun[] @relation("PayrollRunCreator")
  payrollRunsApproved PayrollRun[] @relation("PayrollRunApprover")
  payslips       Payslip[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  payrollAdjustmentsCreated PayrollAdjustment[] @relation("PayrollAdjustmentCreator")
  payrollAdjustmentsApproved PayrollAdjustment[] @relation("PayrollAdjustmentApprover")
  payslipDisputesCreated PayslipDispute[] @relation("PayslipDisputeCreator")
  payslipDisputesHandled PayslipDispute[] @relation("PayslipDisputeHandler")
  lifecycleEventsCreated EmployeeLifecycleEvent[] @relation("LifecycleEventCreator")
  onboardingTasksAssigned OnboardingTask[] @relation("OnboardingTaskAssignee")
  onboardingTasksCreated OnboardingTask[] @relation("OnboardingTaskCreator")
  offboardingTasksAssigned OffboardingTask[] @relation("OffboardingTaskAssignee")
  offboardingTasksCreated OffboardingTask[] @relation("OffboardingTaskCreator")
  assetAssignmentsOperated AssetAssignment[] @relation("AssetAssignmentOperator")
  helpdeskTicketsCreated HelpdeskTicket[] @relation("HelpdeskTicketCreator")
  helpdeskTicketsAssigned HelpdeskTicket[] @relation("HelpdeskTicketAssignee")
  helpdeskComments HelpdeskTicketComment[]
  recruitmentRequestsCreated RecruitmentRequest[] @relation("RecruitmentRequestCreator")
  jobOpeningsCreated JobOpening[] @relation("JobOpeningCreator")
  candidatesCreated Candidate[] @relation("CandidateCreator")
  interviewRoundsInterviewer InterviewRound[] @relation("InterviewInterviewer")
  offersCreated Offer[] @relation("OfferCreator")
  performanceCyclesCreated PerformanceCycle[] @relation("PerformanceCycleCreator")
  performanceGoalsCreated PerformanceGoal[] @relation("PerformanceGoalCreator")
  performanceReviewsReviewer PerformanceReview[] @relation("PerformanceReviewReviewer")
  performanceReviewsCreated PerformanceReview[] @relation("PerformanceReviewCreator")
  trainingCoursesCreated TrainingCourse[] @relation("TrainingCourseCreator")
  trainingSessionsInstructor TrainingSession[] @relation("TrainingSessionInstructor")
  trainingSessionsCreated TrainingSession[] @relation("TrainingSessionCreator")

  @@index([departmentId, status])
  @@index([status])
  @@index([loginLockedUntil])
  @@map("users")
}

model PayslipPassword {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique @map("user_id")
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  isDefault      Boolean   @default(true) @map("is_default")
  lastChangedAt  DateTime  @default(now()) @map("last_changed_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payslip_passwords")
}

model Employee {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique @map("user_id")
  employeeNo    String    @unique @map("employee_no") @db.VarChar(20)
  hireDate      DateTime  @map("hire_date")
  salary        Decimal?  @db.Decimal(10, 2)
  status        String    @default("active") @db.VarChar(20)
  emergencyContact String? @map("emergency_contact") @db.VarChar(50)
  emergencyPhone   String? @map("emergency_phone") @db.VarChar(20)
  address       String?   @db.VarChar(200)
  education     String?   @db.VarChar(20)
  skills        String?
  remark        String?
  rating        Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes       EmployeeChange[]
  leaveRequests LeaveRequest[]
  overtimeRequests OvertimeRequest[]
  reimbursements Reimbursement[]
  attendances   AttendanceRecord[]
  schedules     Schedule[]
  vacationBalances VacationBalance[]
  attendanceCheckins AttendanceCheckin[]
  attendanceDailyRecords AttendanceDaily[]
  attendanceMonthlyRecords AttendanceMonthly[]
  attendanceExceptions AttendanceException[]
  salaryAssignments SalaryAssignment[]
  payslips      Payslip[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  payrollAdjustments PayrollAdjustment[]
  payslipDisputes PayslipDispute[]
  lifecycleEvents EmployeeLifecycleEvent[]
  onboardingTasks OnboardingTask[]
  offboardingTasks OffboardingTask[]
  documents EmployeeDocument[]
  contracts EmployeeContract[]
  assignedAssets AssetItem[]
  assetAssignments AssetAssignment[]
  helpdeskTickets HelpdeskTicket[]
  performanceGoals PerformanceGoal[]
  performanceReviews PerformanceReview[]
  trainingEnrollments TrainingEnrollment[]

  @@index([status])
  @@map("employees")
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  parentId    Int?      @map("parent_id")
  description String?
  managerId   Int?      @map("manager_id")
  status      String    @default("active") @db.VarChar(20)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      Department? @relation("parentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("parentChildren")
  manager     User?       @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)
  users       User[]      @relation("UserDept")
  positions   Position[]
  shifts      Shift[]
  recruitmentRequests RecruitmentRequest[]
  jobOpenings JobOpening[]

  @@map("departments")
}

model Position {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  departmentId   Int       @map("department_id")
  description    String?
  requirements   String?
  responsibilities String?
  salaryMin      Decimal?  @map("salary_min") @db.Decimal(10, 2)
  salaryMax      Decimal?  @map("salary_max") @db.Decimal(10, 2)
  status         String    @default("active") @db.VarChar(20)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users          User[]
  recruitmentRequests RecruitmentRequest[]
  jobOpenings    JobOpening[]

  @@map("positions")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?
  level       Int       @default(1)
  isSystem    Boolean   @default(false) @map("is_system")
  canViewAllDepts Boolean @default(false) @map("can_view_all_departments")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userRoles   UserRole[]
  rolePermissions RolePermission[]
  dataScopes  RoleDataScope[]

  @@map("roles")
}

model RoleDataScope {
  id            Int      @id @default(autoincrement())
  roleId        Int      @map("role_id")
  scopeType     String   @default("self") @map("scope_type") @db.VarChar(50)
  departmentIds Json?    @map("department_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId])
  @@map("role_data_scopes")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  code        String    @unique @db.VarChar(50)
  resource    String    @db.VarChar(50)
  action      String    @db.VarChar(50)
  description String?
  module      String    @db.VarChar(50)
  parentId    Int?      @map("parent_id")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent      Permission? @relation("permissionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Permission[] @relation("permissionTree")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Shift {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(50)
  code         String    @unique @db.VarChar(50)
  departmentId Int?      @map("department_id")
  startTime    String    @map("start_time") @db.VarChar(10)
  endTime      String    @map("end_time") @db.VarChar(10)
  workHours    Decimal   @map("work_hours") @db.Decimal(4, 2)
  isFlexible   Boolean   @default(false) @map("is_flexible")
  isCrossDay   Boolean   @default(false) @map("is_cross_day")
  beginCheckinMinutes  Int @default(60) @map("begin_checkin_minutes")
  allowCheckoutMinutes Int @default(60) @map("allow_checkout_minutes")
  lateGraceMinutes     Int @default(0) @map("late_grace_minutes")
  earlyGraceMinutes    Int @default(0) @map("early_grace_minutes")
  color        String?   @db.VarChar(20)
  description  String?
  status       String    @default("active") @db.VarChar(20)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules    Schedule[]
  dailyRecords AttendanceDaily[]

  @@map("shifts")
}

model Schedule {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  employeeId    Int       @map("employee_id")
  shiftId       Int       @map("shift_id")
  scheduleDate  DateTime  @map("schedule_date") @db.Date
  status        String    @default("normal") @db.VarChar(20)
  note          String?
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation("scheduleUser", fields: [userId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  creator       User?     @relation("creator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, scheduleDate])
  @@index([scheduleDate, userId])
  @@index([scheduleDate, shiftId])
  @@index([employeeId, scheduleDate])
  @@map("schedules")
}

model AttendanceRecord {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  employeeId     Int       @map("employee_id")
  date           DateTime  @db.Date
  shiftId        Int?      @map("shift_id")
  checkIn        DateTime? @map("check_in")
  checkOut       DateTime? @map("check_out")
  workHours      Decimal?  @map("work_hours") @db.Decimal(4, 2)
  status         String    @default("normal") @db.VarChar(20)
  lateMinutes    Int       @default(0) @map("late_minutes")
  earlyMinutes   Int       @default(0) @map("early_minutes")
  locationIn     String?   @map("location_in") @db.VarChar(100)
  locationOut    String?   @map("location_out") @db.VarChar(100)
  remark         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, status])
  @@index([userId, date])
  @@index([employeeId, date])
  @@map("attendance_records")
}

model AttendanceCheckin {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  employeeId  Int      @map("employee_id")
  deviceId    String?  @map("device_id") @db.VarChar(100)
  source      String   @default("web") @db.VarChar(30)
  logType     String   @default("unknown") @map("log_type") @db.VarChar(20)
  checkTime   DateTime @map("check_time")
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  address     String?  @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  photoUrl    String?  @map("photo_url") @db.VarChar(500)
  rawPayload  Json?    @map("raw_payload")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, checkTime])
  @@map("attendance_checkins")
}

model AttendanceDaily {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  employeeId          Int       @map("employee_id")
  date                DateTime  @db.Date
  shiftId             Int?      @map("shift_id")
  status              String    @default("normal") @db.VarChar(30)
  firstIn             DateTime? @map("first_in")
  lastOut             DateTime? @map("last_out")
  workMinutes         Int       @default(0) @map("work_minutes")
  lateMinutes         Int       @default(0) @map("late_minutes")
  earlyMinutes        Int       @default(0) @map("early_minutes")
  absentMinutes       Int       @default(0) @map("absent_minutes")
  overtimeMinutes     Int       @default(0) @map("overtime_minutes")
  checkinSnapshot     Json?     @map("checkin_snapshot")
  ruleSnapshot        Json?     @map("rule_snapshot")
  calculationVersion  String?   @map("calculation_version") @db.VarChar(50)
  lockedAt            DateTime? @map("locked_at")
  lockedBy            Int?      @map("locked_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift               Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date, status])
  @@index([userId, date])
  @@map("attendance_daily")
}

model AttendanceMonthly {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  employeeId           Int      @map("employee_id")
  year                Int
  month               Int
  expectedWorkDays    Decimal  @default(0) @map("expected_work_days") @db.Decimal(6, 2)
  actualWorkDays      Decimal  @default(0) @map("actual_work_days") @db.Decimal(6, 2)
  paidLeaveDays       Decimal  @default(0) @map("paid_leave_days") @db.Decimal(6, 2)
  unpaidLeaveDays     Decimal  @default(0) @map("unpaid_leave_days") @db.Decimal(6, 2)
  absentDays          Decimal  @default(0) @map("absent_days") @db.Decimal(6, 2)
  lateCount           Int      @default(0) @map("late_count")
  earlyCount          Int      @default(0) @map("early_count")
  missingCheckinCount Int      @default(0) @map("missing_checkin_count")
  overtimeMinutes     Int      @default(0) @map("overtime_minutes")
  status              String   @default("draft") @db.VarChar(30)
  lockedAt            DateTime? @map("locked_at")
  lockedBy            Int?     @map("locked_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, month])
  @@index([year, month, status])
  @@index([userId, year, month])
  @@map("attendance_monthly")
}

model AttendanceException {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  date        DateTime @db.Date
  type        String   @db.VarChar(50)
  status      String   @default("pending") @db.VarChar(30)
  relatedIds  Json?    @map("related_ids")
  reason      String?
  approvalId  Int?     @map("approval_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@map("attendance_exceptions")
}

model AttendanceCorrectionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  employeeId  Int      @map("employee_id")
  date        DateTime @db.Date
  logType     String   @map("log_type") @db.VarChar(20)
  checkTime   DateTime @map("check_time")
  reason      String
  status      String   @default("pending") @db.VarChar(30)
  approverId  Int?     @map("approver_id")
  approvedAt  DateTime? @map("approved_at")
  opinion     String?
  checkinId   Int?     @map("checkin_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@map("attendance_correction_requests")
}

model LeaveRequest {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  employeeId     Int       @map("employee_id")
  leaveType      String    @map("leave_type") @db.VarChar(50)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  days           Decimal   @db.Decimal(4, 1)
  reason         String
  status         String    @default("pending") @db.VarChar(20)
  currentStep    Int       @default(0) @map("current_step")
  workflowId     Int?      @map("workflow_id")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvalRecords LeaveApprovalRecord[]

  @@index([employeeId, status, startDate])
  @@index([userId, status, startDate])
  @@map("leave_requests")
}

model OvertimeRequest {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  employeeId     Int       @map("employee_id")
  overtimeType   String    @map("overtime_type") @db.VarChar(50)
  date           DateTime  @db.Date
  startTime      String    @map("start_time") @db.VarChar(10)
  endTime        String    @map("end_time") @db.VarChar(10)
  hours          Decimal   @db.Decimal(4, 1)
  reason         String
  status         String    @default("pending") @db.VarChar(20)
  currentStep    Int       @default(0) @map("current_step")
  workflowId     Int?      @map("workflow_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status, date])
  @@index([userId, status, date])
  @@map("overtime_requests")
}

model Reimbursement {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  employeeId     Int       @map("employee_id")
  title          String    @db.VarChar(200)
  type           String    @db.VarChar(50)
  amount         Decimal   @db.Decimal(12, 2)
  expenseDate    DateTime  @map("expense_date") @db.Date
  description    String?
  status         String    @default("pending") @db.VarChar(20)
  currentStep    Int       @default(0) @map("current_step")
  workflowId     Int?      @map("workflow_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvalRecords ReimbursementApproval[]

  @@index([employeeId, status, expenseDate])
  @@index([userId, status, expenseDate])
  @@map("reimbursements")
}

model ApprovalWorkflow {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  type        String    @default("leave") @db.VarChar(50)
  description String?
  isDefault   Boolean   @default(false) @map("is_default")
  conditions  Json?
  status      String    @default("active") @db.VarChar(20)
  createdBy   Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  nodes       ApprovalNode[]

  @@map("approval_workflows")
}

model ApprovalNode {
  id             Int       @id @default(autoincrement())
  workflowId     Int       @map("workflow_id")
  nodeOrder      Int       @default(1) @map("node_order")
  nodeName       String    @map("node_name") @db.VarChar(100)
  approverType   String    @map("approver_type") @db.VarChar(50)
  approverId     Int?      @map("approver_id")
  roleId         Int?      @map("role_id")
  approvalMode   String    @default("serial") @map("approval_mode") @db.VarChar(20)
  canSkip        Boolean   @default(false) @map("can_skip")
  skipConditions Json?     @map("skip_conditions")
  createdAt      DateTime  @default(now()) @map("created_at")

  workflow       ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("approval_nodes")
}

model LeaveApprovalRecord {
  id        Int      @id @default(autoincrement())
  leaveId   Int      @map("leave_id")
