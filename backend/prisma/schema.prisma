  code        String    @unique @db.VarChar(50)
  appUrl      String    @map("app_url") @db.VarChar(500)
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  description String?
  status      String    @default("active") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("sso_apps")
}

model SalaryComponent {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  type        String   @db.VarChar(30)
  amountType  String   @default("fixed") @map("amount_type") @db.VarChar(30)
  formula     String?
  taxable     Boolean  @default(false)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  structureItems SalaryStructureItem[]
  payslipItems   PayslipItem[]
  payrollAdjustments PayrollAdjustment[]

  @@map("salary_components")
}

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  payrollFrequency String   @default("monthly") @map("payroll_frequency") @db.VarChar(30)
  status           String   @default("draft") @db.VarChar(30)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  items            SalaryStructureItem[]
  assignments      SalaryAssignment[]

  @@map("salary_structures")
}

model SalaryStructureItem {
  id                Int      @id @default(autoincrement())
  salaryStructureId Int      @map("salary_structure_id")
  componentId       Int      @map("component_id")
  amount            Decimal? @db.Decimal(12, 2)
  formula           String?
  condition         String?
  sortOrder         Int      @default(0) @map("sort_order")

  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  component         SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@map("salary_structure_items")
}

model SalaryAssignment {
  id                Int      @id @default(autoincrement())
  employeeId         Int      @map("employee_id")
  salaryStructureId  Int      @map("salary_structure_id")
  baseSalary         Decimal  @map("base_salary") @db.Decimal(12, 2)
  effectiveFrom      DateTime @map("effective_from") @db.Date
  effectiveTo        DateTime? @map("effective_to") @db.Date
  status             String   @default("active") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure    SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
  @@map("salary_assignments")
}

model PayrollPeriod {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("open") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payrollRuns PayrollRun[]

  @@unique([year, month])
  @@map("payroll_periods")
}

model PayrollRun {
  id              Int      @id @default(autoincrement())
  payrollPeriodId Int      @map("payroll_period_id")
  scopeType       String   @default("all") @map("scope_type") @db.VarChar(30)
  scopeValue      Json?    @map("scope_value")
  status          String   @default("draft") @db.VarChar(30)
  createdBy       Int      @map("created_by")
  approvedBy      Int?     @map("approved_by")
  lockedAt        DateTime? @map("locked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  creator         User @relation("PayrollRunCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver        User? @relation("PayrollRunApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  payslips        Payslip[]

  @@index([payrollPeriodId, status])
  @@index([createdBy, status])
  @@map("payroll_runs")
}

model Payslip {
  id                 Int      @id @default(autoincrement())
  payrollRunId        Int      @map("payroll_run_id")
  employeeId          Int      @map("employee_id")
  userId              Int      @map("user_id")
  grossPay            Decimal  @default(0) @map("gross_pay") @db.Decimal(12, 2)
  totalDeduction      Decimal  @default(0) @map("total_deduction") @db.Decimal(12, 2)
  netPay              Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  expectedWorkDays    Decimal  @default(0) @map("expected_work_days") @db.Decimal(6, 2)
  paidDays            Decimal  @default(0) @map("paid_days") @db.Decimal(6, 2)
  absentDays          Decimal  @default(0) @map("absent_days") @db.Decimal(6, 2)
  unpaidLeaveDays     Decimal  @default(0) @map("unpaid_leave_days") @db.Decimal(6, 2)
  overtimeAmount      Decimal  @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  status              String   @default("draft") @db.VarChar(30)
  attendanceSnapshot  Json?    @map("attendance_snapshot")
  formulaSnapshot     Json?    @map("formula_snapshot")
  publishedAt         DateTime? @map("published_at")
  viewedAt            DateTime? @map("viewed_at")
  confirmedAt         DateTime? @map("confirmed_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               PayslipItem[]
  disputes            PayslipDispute[]

  @@index([userId, status])
  @@index([employeeId, payrollRunId])
  @@index([payrollRunId, status])
  @@map("payslips")
}

model PayrollAdjustment {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @map("employee_id")
  componentId Int      @map("component_id")
  year        Int
  month       Int
  type        String   @db.VarChar(30)
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  status      String   @default("pending") @db.VarChar(30)
  createdBy   Int      @map("created_by")
  approvedBy  Int?     @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  approvalOpinion String? @map("approval_opinion")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  creator     User @relation("PayrollAdjustmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver    User? @relation("PayrollAdjustmentApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId, year, month, status])
  @@map("payroll_adjustments")
}

model PayslipDispute {
  id          Int      @id @default(autoincrement())
  payslipId   Int      @map("payslip_id")
  employeeId  Int      @map("employee_id")
  userId      Int      @map("user_id")
  reason      String
  status      String   @default("pending") @db.VarChar(30)
  handlerId   Int?     @map("handler_id")
  handlerReply String? @map("handler_reply")
  handledAt   DateTime? @map("handled_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payslip     Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user        User @relation("PayslipDisputeCreator", fields: [userId], references: [id], onDelete: Cascade)
  handler     User? @relation("PayslipDisputeHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  @@index([payslipId, status])
  @@map("payslip_disputes")
}

model PayslipItem {
  id              Int      @id @default(autoincrement())
  payslipId       Int      @map("payslip_id")
  componentId     Int      @map("component_id")
  type            String   @db.VarChar(30)
  amount          Decimal  @db.Decimal(12, 2)
  formulaSnapshot String?  @map("formula_snapshot")
  sourceType      String?  @map("source_type") @db.VarChar(50)
  sourceId        Int?     @map("source_id")
  sortOrder       Int      @default(0) @map("sort_order")

  payslip         Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@map("payslip_items")
}

model SystemLog {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  username    String?   @db.VarChar(50)
  action      String    @db.VarChar(100)
  module      String    @db.VarChar(50)
  ipAddress   String?   @map("ip_address") @db.VarChar(50)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  requestData Json?     @map("request_data")
  responseData Json?    @map("response_data")
  status      String    @default("success") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([username, createdAt])
  @@index([status, createdAt])
  @@map("system_logs")
}
